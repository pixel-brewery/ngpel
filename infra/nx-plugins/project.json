{
    "name": "nx-plugins",
    "sourceRoot": "infra/nx-plugins/src",
    "projectType": "library",
    "tags": ["type:tooling"],
    "targets": {
        "dependabot": {
            "executor": "nx-plugins:dependabot",
            "cache": false,
            "options": {
                "mode": "merge"
            }
        },
        "release": {
            "executor": "nx-plugins:release",
            "cache": false,
            "options": {
                "mode": "classify"
            }
        },
        "ci-check": {
            "executor": "nx:run-commands",
            "dependsOn": ["typecheck"],
            "options": {
                "command": "vitest run --config=.github/scripts/vitest.config.mjs"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc -p infra/nx-plugins/tsconfig.automation.json --noEmit"
            }
        }
    }
}
