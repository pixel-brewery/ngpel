{
    "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": { "analytics": false },
    "newProjectRoot": ".",
    "projects": {
        "fixture-ng22": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist",
                        "browser": "src/main.ts",
                        "index": "src/index.html",
                        "tsConfig": "tsconfig.app.json",
                        "optimization": true,
                        "outputHashing": "none",
                        "sourceMap": false,
                        "namedChunks": false,
                        "budgets": []
                    }
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": { "buildTarget": "fixture-ng22:build" }
                }
            }
        }
    }
}
