{
    "name": "fixture-ng22",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/fixtures/ng22/src",
    "projectType": "application",
    "tags": ["app", "type:app", "fixture"],
    "implicitDependencies": ["core", "mvp", "ui", "forms", "router"],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": "dependencies",
                    "target": "build"
                }
            ],
            "outputs": ["{projectRoot}/dist"],
            "options": {
                "command": "node tools/fixture.mjs",
                "cwd": "{workspaceRoot}"
            }
        }
    }
}
