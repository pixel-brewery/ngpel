{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "@pixel-brewery/ngpel-core": ["libs/core/dist/types/pixel-brewery-ngpel-core.d.ts"],
            "@pixel-brewery/ngpel-core/rx": ["libs/core/dist/types/pixel-brewery-ngpel-core-rx.d.ts"],
            "@pixel-brewery/ngpel-core/storage": ["libs/core/dist/types/pixel-brewery-ngpel-core-storage.d.ts"],
            "@pixel-brewery/ngpel-core/browser": ["libs/core/dist/types/pixel-brewery-ngpel-core-browser.d.ts"],
            "@pixel-brewery/ngpel-core/notification": ["libs/core/dist/types/pixel-brewery-ngpel-core-notification.d.ts"],
            "@pixel-brewery/ngpel-core/update": ["libs/core/dist/types/pixel-brewery-ngpel-core-update.d.ts"],
            "@pixel-brewery/ngpel-core/audio": ["libs/core/dist/types/pixel-brewery-ngpel-core-audio.d.ts"],
            "@pixel-brewery/ngpel-core/search": ["libs/core/dist/types/pixel-brewery-ngpel-core-search.d.ts"],
            "@pixel-brewery/ngpel-mvp": ["libs/mvp/dist/types/pixel-brewery-ngpel-mvp.d.ts"],
            "@pixel-brewery/ngpel-router": ["libs/router/dist/types/pixel-brewery-ngpel-router.d.ts"],
            "@pixel-brewery/ngpel-router/navigation": ["libs/router/dist/types/pixel-brewery-ngpel-router-navigation.d.ts"],
            "@pixel-brewery/ngpel-router/shell": ["libs/router/dist/types/pixel-brewery-ngpel-router-shell.d.ts"]
        },
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": false,
        "inlineSources": true,
        "types": [],
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "angularCompilerOptions": {
        "compilationMode": "partial",
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["**/*.spec.ts", "**/*.test.ts", "src/test-setup.ts", "dist"]
}
