{
    "compileOnSave": false,
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "rootDir": ".",
        "baseUrl": ".",
        "sourceMap": true,
        "declaration": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "importHelpers": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "paths": {
            "@pixel-brewery/ngpel-core": ["libs/core/src/index.ts"],
            "@pixel-brewery/ngpel-core/audio": ["libs/core/src/audio/index.ts"],
            "@pixel-brewery/ngpel-core/browser": ["libs/core/src/browser/index.ts"],
            "@pixel-brewery/ngpel-core/notification": ["libs/core/src/notification/index.ts"],
            "@pixel-brewery/ngpel-core/rx": ["libs/core/src/rx/index.ts"],
            "@pixel-brewery/ngpel-core/search": ["libs/core/src/search/index.ts"],
            "@pixel-brewery/ngpel-core/storage": ["libs/core/src/storage/index.ts"],
            "@pixel-brewery/ngpel-core/update": ["libs/core/src/update/index.ts"],
            "@pixel-brewery/ngpel-forms": ["libs/forms/src/index.ts"],
            "@pixel-brewery/ngpel-mvp": ["libs/mvp/src/index.ts"],
            "@pixel-brewery/ngpel-router": ["libs/router/src/index.ts"],
            "@pixel-brewery/ngpel-router/navigation": ["libs/router/src/navigation/index.ts"],
            "@pixel-brewery/ngpel-router/shell": ["libs/router/src/shell/index.ts"],
            "@pixel-brewery/ngpel-ui": ["libs/ui/src/index.ts"],
            "@pixel-brewery/ngpel-ui/markdown": ["libs/ui/src/markdown/index.ts"],
            "@pixel-brewery/ngpel-ui/widget": ["libs/ui/src/widget/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp", "**/dist"]
}
