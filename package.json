{
    "name": "ngpel",
    "version": "0.0.0",
    "description": "ngpel — shared Angular frontend companion libraries (the frontend sister of Archipel)",
    "keywords": [
        "angular",
        "typescript",
        "frontend",
        "libraries",
        "angular-signals",
        "rxjs",
        "model-view-presenter",
        "signal-forms",
        "routing",
        "ui-components",
        "monorepo",
        "nx",
        "ngpel"
    ],
    "homepage": "https://github.com/pixel-brewery/ngpel#readme",
    "bugs": {
        "url": "https://github.com/pixel-brewery/ngpel/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pixel-brewery/ngpel.git"
    },
    "author": "Pixel Brewery (https://github.com/pixel-brewery)",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "yarn@4.10.3",
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
        "yarn": ">=4.0.0"
    },
    "workspaces": [
        "libs/*",
        "apps/frontend/*",
        "apps/fixtures/*",
        "infra/*",
        "tools/*"
    ],
    "scripts": {
        "nx": "nx",
        "agents:check": "node tools/verify-project-guidance.mjs",
        "postinstall": "husky",
        "build": "nx run-many --target=build --projects=tag:lib --parallel=1",
        "test": "nx run-many --target=test --projects=tag:lib --parallel=1 --maxWorkers=1",
        "lint": "nx run-many --target=lint --parallel=1",
        "typecheck": "nx run-many --target=typecheck --projects=tag:lib --parallel=1",
        "docs": "nx run-many --target=docs --projects=tag:lib --parallel=1",
        "docs:dev": "nx run docs:dev",
        "docs:build": "nx run docs:build",
        "docs:preview": "nx run docs:preview",
        "format": "nx format:write --all",
        "format:check": "nx format:check --all",
        "release": "yarn run release:patch",
        "release:first": "yarn run release:patch",
        "release:first:dry-run": "yarn run release:nx --specifier=patch --first-release --dry-run",
        "release:minor": "gh workflow run release.yml --ref main -f specifier=minor",
        "release:patch": "gh workflow run release.yml --ref main -f specifier=patch",
        "release:dry-run": "yarn run release:nx --specifier=patch --dry-run",
        "release:nx": "nx release --skip-publish",
        "release:publish": "yarn build && yarn verify:esm && nx release publish --nxBail --outputStyle=static",
        "release:verify": "node tools/verify-published-packages.mjs",
        "prepare": "yarn run format && yarn run lint && yarn run test",
        "serve": "nx run docs:dev",
        "update": "yarn upgrade-interactive",
        "spell": "cspell --gitignore .",
        "verify:esm": "node tools/verify-esm-packages.mjs",
        "verify": "yarn agents:check && yarn public:check && yarn format:check && yarn ci:check && yarn lint && yarn test && yarn spell && yarn docs && yarn build && yarn verify:esm",
        "public:check": "node .github/scripts/findPrivateReferences.mjs",
        "release:major": "gh workflow run release.yml --ref main -f specifier=major",
        "ci:check": "vitest run --config=.github/scripts/vitest.config.mjs",
        "packaging:test": "vitest run --config=.github/scripts/vitest.config.mjs tools/verify-esm-packages.spec.mjs tools/verify-published-packages.spec.mjs"
    },
    "devDependencies": {
        "@angular-devkit/core": "22.1.6",
        "@angular-devkit/schematics": "22.1.6",
        "@angular/build": "22.1.6",
        "@angular/cdk": "22.1.4",
        "@angular/cli": "22.1.6",
        "@angular/common": "22.1.4",
        "@angular/compiler": "22.1.4",
        "@angular/compiler-cli": "22.1.4",
        "@angular/core": "22.1.4",
        "@angular/forms": "22.1.4",
        "@angular/google-maps": "22.1.4",
        "@angular/platform-browser": "22.1.4",
        "@angular/router": "22.1.4",
        "@angular/service-worker": "22.1.4",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-angular": "^0.1.4",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-sass": "^6.0.2",
        "@codemirror/lang-vue": "^0.1.3",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.4",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/search": "^6.7.0",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.1",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@eslint/js": "10.0.1",
        "@floating-ui/dom": "^1.8.0",
        "@google/design.md": "^0.4.0",
        "@googlemaps/markerclusterer": "2.6.2",
        "@lezer/highlight": "^1.2.3",
        "@lit-labs/virtualizer": "^2.1.1",
        "@lit/context": "^1.1.6",
        "@lit/task": "^1.0.3",
        "@nx/angular": "23.1.2",
        "@nx/devkit": "23.1.2",
        "@nx/eslint": "23.1.2",
        "@nx/eslint-plugin": "23.1.2",
        "@nx/js": "23.1.2",
        "@nx/vite": "23.1.2",
        "@nx/vitest": "23.1.2",
        "@nx/web": "23.1.2",
        "@pixel-brewery/markdowner-core": "0.1.96",
        "@pixel-brewery/mosaik-elements-angular": "0.1.188",
        "@pixel-brewery/mosaik-elements-foundation": "0.1.188",
        "@pixel-brewery/mosaik-themes": "0.1.188",
        "@replit/codemirror-lang-svelte": "^6.0.0",
        "@schematics/angular": "22.1.6",
        "@simplewebauthn/browser": "13.3.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.1",
        "@swc/helpers": "0.5.23",
        "@tiptap/core": "3.32.0",
        "@tiptap/extension-bold": "3.32.0",
        "@tiptap/extension-code": "3.32.0",
        "@tiptap/extension-document": "3.32.0",
        "@tiptap/extension-emoji": "3.32.0",
        "@tiptap/extension-hard-break": "3.32.0",
        "@tiptap/extension-italic": "3.32.0",
        "@tiptap/extension-mention": "3.32.0",
        "@tiptap/extension-paragraph": "3.32.0",
        "@tiptap/extension-placeholder": "3.32.0",
        "@tiptap/extension-strike": "3.32.0",
        "@tiptap/extension-text": "3.32.0",
        "@tiptap/extension-underline": "3.32.0",
        "@tiptap/extensions": "3.32.0",
        "@tiptap/pm": "3.32.0",
        "@tiptap/suggestion": "3.32.0",
        "@types/node": "26.4.0",
        "@typescript-eslint/parser": "8.68.0",
        "@typescript-eslint/utils": "8.68.0",
        "@vitest/coverage-v8": "4.1.11",
        "angular-eslint": "22.1.0",
        "apexcharts": "^8.4.1",
        "chroma-js": "^3.2.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "gray-matter": "4.0.3",
        "husky": "9.1.7",
        "jsdom": "30.0.1",
        "jsonc-eslint-parser": "3.3.0",
        "lint-staged": "17.4.1",
        "lit": "^3.3.1",
        "marked": "18.0.11",
        "ng-packagr": "22.1.1",
        "nx": "23.1.2",
        "prettier": "3.9.6",
        "qr-creator": "^1.0.0",
        "rxjs": "7.8.2",
        "signature_pad": "^5.1.4",
        "tslib": "2.8.1",
        "type-fest": "5.8.0",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.13.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.68.0",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    }
}
